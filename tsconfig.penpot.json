{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.penpot.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "composite": true
  },
  "include": [
    "./src/types/penpot.d.ts",
    "src/**/*.penpot.ts",
    "src/settings.ts",
    "src/messages/*.ts"
  ]
}
